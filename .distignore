# Files and folders NOT shipped to WordPress.org or in the release zip.

# VCS / CI / editor
/.git
/.github
/.gitignore
/.gitattributes
/.distignore
/.editorconfig
/.nvmrc
/.idea
/.vscode
/.tx
# WordPress.org assets (banner, icons, screenshots); the release workflow deploys them to the assets folder.
/.wordpress-org

# Local environments
/.wp-env.json
/.wp-env.test.json
/.wp-env.upgrade.json

# Tooling and tests
/tests
/scripts
/phpcs.xml.dist
/phpstan.neon.dist
/phpstan-baseline.neon
/phpunit.xml.dist
/phpunit-integration.xml.dist
/phpunit-quality.xml.dist
/composer.json
/composer.lock
/package.json
/package-lock.json
/node_modules
/assets/css/scss
/tsconfig.json
/vite.config.mts
# The app sources in assets/src are shipped (human-readable source, as wordpress.org asks), their tests are not.
*.test.ts
*.test.tsx
/assets/src/test-setup.ts
# Notes for coding assistants that Action Scheduler ships; not needed on a site.
/vendor/woocommerce/action-scheduler/AGENTS.md
/vendor/woocommerce/action-scheduler/CLAUDE.md

# Caches and reports
/.phpstan.cache
/.phpunit.result.cache
/.phpunit-integration.result.cache
/.phpunit-quality.result.cache
/coverage
/coverage-integration
/coverage.xml
/artifacts

# OS
.DS_Store
Thumbs.db
