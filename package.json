{
  "name": "related-posts-for-wp",
  "title": "Related Posts for WordPress",
  "version": "3.0.0-rc.5",
  "private": true,
  "description": "Related Posts for WordPress: development tooling.",
  "homepage": "https://wordpress.org/plugins/related-posts-for-wp/",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/barrykooij/related-posts-for-wp.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:css && npm run build:js && npm run build:admin",
    "build:css": "sass --style=compressed --no-source-map assets/css/scss:assets/css",
    "build:js": "node scripts/build-js.mjs",
    "build:admin": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint:js": "wp-scripts lint-js assets/src tests/e2e scripts vite.config.mts",
    "lint:js:legacy": "wp-scripts lint-js \"assets/js/*.js\" --ignore-pattern \"*.min.js\"",
    "lint:style:legacy": "wp-scripts lint-style \"assets/css/scss/**/*.scss\"",
    "lint:style": "wp-scripts lint-style \"assets/src/**/*.scss\"",
    "test:js": "vitest run",
    "env": "wp-env",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:test:start": "wp-env --config=.wp-env.test.json start",
    "env:test:stop": "wp-env --config=.wp-env.test.json stop",
    "env:test:clean": "wp-env --config=.wp-env.test.json reset all",
    "test:integration": "wp-env --config=.wp-env.test.json run cli --env-cwd=wp-content/plugins/related-posts-for-wp vendor/bin/phpunit -c phpunit-integration.xml.dist",
    "test:integration:ajax": "wp-env --config=.wp-env.test.json run cli --env-cwd=wp-content/plugins/related-posts-for-wp vendor/bin/phpunit -c phpunit-integration.xml.dist --group ajax",
    "test:integration:record": "wp-env --config=.wp-env.test.json run cli --env-cwd=wp-content/plugins/related-posts-for-wp bash -c 'RP4WP_UPDATE_GOLDEN=1 vendor/bin/phpunit -c phpunit-integration.xml.dist --group golden'",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts",
    "screenshots": "playwright test --config=tests/e2e/screenshots.config.ts",
    "test:upgrade": "bash scripts/upgrade-test.sh",
    "i18n:pot": "wp-env run cli --env-cwd=wp-content/plugins/related-posts-for-wp wp i18n make-pot . languages/related-posts-for-wp.pot --exclude=node_modules,vendor,tests,scripts,artifacts,coverage,coverage-integration"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@wordpress/a11y": "4.19.1",
    "@wordpress/api-fetch": "7.19.2",
    "@wordpress/components": "29.5.4",
    "@wordpress/data": "10.19.2",
    "@wordpress/dom-ready": "4.19.1",
    "@wordpress/e2e-test-utils-playwright": "^2.1.0",
    "@wordpress/element": "6.19.1",
    "@wordpress/env": "^11.16.0",
    "@wordpress/hooks": "4.19.1",
    "@wordpress/i18n": "5.19.1",
    "@wordpress/icons": "10.19.1",
    "@wordpress/notices": "5.19.2",
    "@wordpress/scripts": "^36.0.0",
    "@wordpress/url": "4.19.2",
    "jsdom": "^30.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sass": "^1.93.0",
    "terser": "^5.44.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
