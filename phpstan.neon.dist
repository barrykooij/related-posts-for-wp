# Related Posts for WordPress PHPStan configuration.
#
# Starts at level 5; raise the level step by step towards 8 as the reported errors are fixed.
#
# The legacy classes/ and includes/ code is scanned for symbols but not analysed, because it is replaced class by
# class during the 3.x rework. New code is added to `paths` as it lands.
#
# Baseline additions require a `# BASELINE:` comment block per entry in phpstan-baseline.neon explaining the WP stub
# gap or WP runtime quirk.

includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    phpVersion: 80000
    paths:
        - src
        - deprecated
        - tests
        - related-posts-for-wp.php
        - uninstall.php
    excludePaths:
        analyse:
            - tests/Fixtures/*
            - tests/e2e/*
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
    tmpDir: .phpstan.cache
    bootstrapFiles:
        - vendor/autoload.php
        - tests/phpstan-bootstrap.php
    scanDirectories:
        - classes
        - includes
        # The WordPress test suite classes (WP_UnitTestCase and friends) used by the integration tests.
        - vendor/wp-phpunit/wp-phpunit/includes
    dynamicConstantNames:
        # yoast/wp-test-utils defines ABSPATH as `true`; pin the real type.
        ABSPATH: string
        RP4WP_PLUGIN_FILE: string
