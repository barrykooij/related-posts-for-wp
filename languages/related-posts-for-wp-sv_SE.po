#: assets/build/admin/index.js:19
msgid "Version %s"
msgstr "Version %s"

#: assets/build/admin/index.js:22
msgid "Premium"
msgstr "Premium"

#: assets/build/admin/index.js:22
msgid "Related Posts settings"
msgstr "Inställningar för Related Posts"

#: assets/build/admin/index.js:22
msgid "Unsaved changes"
msgstr "Osparade ändringar"

#: assets/build/admin/index.js:22
msgid "You have unsaved changes."
msgstr "Du har osparade ändringar."

#: assets/build/admin/index.js:22
msgid "Discard"
msgstr "Förkasta"

#: assets/build/admin/index.js:22
msgid "Settings saved."
msgstr "Inställningarna har sparats."

#: assets/build/admin/index.js:22
msgid "The settings could not be saved."
msgstr "Inställningarna kunde inte sparas."

#: assets/build/admin/index.js:22
msgid "Save changes"
msgstr "Spara ändringar"

#: assets/build/admin/index.js:22
msgid "This page does not exist."
msgstr "Den här sidan finns inte."

#: assets/build/admin/index.js:22
msgid "This option is overwritten by a filter."
msgstr "Detta alternativ skrivs över av ett filter."

#: assets/build/admin/index.js:22
msgid "An installation is running. You can start another one when it is done."
msgstr "En installation pågår. Du kan starta en ny när den är klar."

#: assets/build/admin/index.js:22
msgid "Link new posts"
msgstr "Länka nya inlägg"

#: assets/build/admin/index.js:22
msgid "Read and link the posts that are not linked yet, for example posts from before automatic linking was on. Links that exist stay as they are."
msgstr "Läs in och länka de inlägg som inte är länkade än, till exempel inlägg från innan automatisk länkning var aktiverad. Befintliga länkar lämnas som de är."

#: assets/build/admin/index.js:22
msgid "Rebuild everything"
msgstr "Bygg om allt"

#: assets/build/admin/index.js:22
msgid "Start over: remove every related post link, also the links you added by hand, read all posts again and link them. Your posts themselves are never touched."
msgstr "Börja om: ta bort alla länkar till relaterade inlägg, även dem du har lagt till manuellt, läs in alla inlägg igen och länka dem. Själva inläggen påverkas aldrig."

#: assets/build/admin/index.js:22
msgid "Rebuild everything?"
msgstr "Bygga om allt?"

#: assets/build/admin/index.js:22
msgid "Remove links and rebuild"
msgstr "Ta bort länkar och bygg om"

#: assets/build/admin/index.js:22
msgid "Keep my links"
msgstr "Behåll mina länkar"

#: assets/build/admin/index.js:22
msgid "Every related post link is removed, including the links you added by hand. This can not be undone."
msgstr "Alla länkar till relaterade inlägg tas bort, även dem du har lagt till manuellt. Detta kan inte ångras."
