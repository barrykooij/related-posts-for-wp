msgid "Installation progress"
msgstr "Installationens förlopp"

#: assets/build/admin/index.js:13
msgid "Background processing is slow on this site, so this page is doing the work now. Keep it open to finish sooner, or come back later."
msgstr "Bakgrundsbearbetningen är långsam på den här webbplatsen, så den här sidan gör jobbet nu. Håll sidan öppen så blir det klart snabbare, eller kom tillbaka senare."

#: assets/build/admin/index.js:13
msgid "Something went wrong."
msgstr "Något gick fel."

#: assets/build/admin/index.js:13
msgid "What was done so far is kept. Resume to finish the rest."
msgstr "Det som redan är gjort sparas. Återuppta för att slutföra resten."

#: assets/build/admin/index.js:13
msgid "Cancel"
msgstr "Avbryt"

#: assets/build/admin/index.js:13
msgid "The installation could not resume."
msgstr "Installationen kunde inte återupptas."

#: assets/build/admin/index.js:13
msgid "Resume"
msgstr "Återuppta"

#: assets/build/admin/index.js:13
msgid "Cancel the installation?"
msgstr "Avbryta installationen?"

#: assets/build/admin/index.js:13
msgid "Cancel installation"
msgstr "Avbryt installationen"

#: assets/build/admin/index.js:13
msgid "Keep running"
msgstr "Låt den fortsätta"

#: assets/build/admin/index.js:13
msgid "The installation could not be cancelled."
msgstr "Installationen kunde inte avbrytas."

#: assets/build/admin/index.js:13
msgid "What was done so far is kept, and you can resume later."
msgstr "Det som redan är gjort sparas, och du kan återuppta senare."

#: assets/build/admin/index.js:13
msgid "Related posts per post"
msgstr "Relaterade inlägg per inlägg"

#: assets/build/admin/index.js:13
msgid "Get started"
msgstr "Kom igång"

#: assets/build/admin/index.js:13
msgid "Let's link your related posts"
msgstr "Nu länkar vi dina relaterade inlägg"

#: assets/build/admin/index.js:13
msgid "Related Posts reads your posts once to learn what each one is about, then links every post to the posts that are most related to it."
msgstr "Related Posts läser in dina inlägg en gång för att lära sig vad vart och ett handlar om, och länkar sedan varje inlägg till de inlägg som är mest relaterade till det."

#: assets/build/admin/index.js:13
msgid "It runs in the background, so you can leave this page while it works."
msgstr "Det körs i bakgrunden, så du kan lämna sidan medan det pågår."

#: assets/build/admin/index.js:13
msgid "You can change this later, and link again at any time."
msgstr "Du kan ändra detta senare och länka igen när som helst."

#: assets/build/admin/index.js:13
msgid "Link the posts right away"
msgstr "Länka inläggen direkt"

#. translators: %s: the name of a tab of the settings screen, for example Installer
#: assets/build/admin/index.js:16
msgid "Turn this off to only read the posts now, and link them later from the %s tab."
msgstr "Stäng av detta för att bara läsa in inläggen nu och länka dem senare från fliken %s."

#: assets/build/admin/index.js:16 assets/build/admin/index.js:22
msgid "The installation could not start."
msgstr "Installationen kunde inte starta."

#: assets/build/admin/index.js:16
msgid "Start"
msgstr "Starta"

#: assets/build/admin/index.js:16
msgid "The installation is done."
msgstr "Installationen är klar."

#: assets/build/admin/index.js:16
msgid "The installation stopped."
msgstr "Installationen stoppades."

