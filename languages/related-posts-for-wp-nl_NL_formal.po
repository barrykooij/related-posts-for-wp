msgid "Rebuild everything?"
msgstr "Alles opnieuw opbouwen?"

#: assets/build/admin/index.js:16
msgid "Remove links and rebuild"
msgstr "Koppelingen verwijderen en opnieuw opbouwen"

#: assets/build/admin/index.js:16
msgid "Keep my links"
msgstr "Mijn koppelingen behouden"

#: assets/build/admin/index.js:16
msgid "Every related post link is removed, including the links you added by hand. This can not be undone."
msgstr "Elke koppeling naar gerelateerde berichten wordt verwijderd, ook de koppelingen die u zelf hebt toegevoegd. Dit kan niet ongedaan worden gemaakt."
