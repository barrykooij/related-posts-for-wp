allation progress":["\u041d\u0430\u043f\u0440\u0435\u0434\u044a\u043a \u043d\u0430 \u0438\u043d\u0441\u0442\u0430\u043b\u0438\u0440\u0430\u043d\u0435\u0442\u043e"],"Background processing is slow on this site, so this page is doing the work now. Keep it open to finish sooner, or come back later.":["\u0424\u043e\u043d\u043e\u0432\u0430\u0442\u0430 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0430 \u043d\u0430 \u0442\u043e\u0437\u0438 \u0441\u0430\u0439\u0442 \u0435 \u0431\u0430\u0432\u043d\u0430, \u0437\u0430\u0442\u043e\u0432\u0430 \u0442\u0430\u0437\u0438 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u0432\u044a\u0440\u0448\u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u0430 \u0441\u0435\u0433\u0430. \u041e\u0441\u0442\u0430\u0432\u0435\u0442\u0435 \u044f \u043e\u0442\u0432\u043e\u0440\u0435\u043d\u0430, \u0437\u0430 \u0434\u0430 \u043f\u0440\u0438\u043a\u043b\u044e\u0447\u0438 \u043f\u043e-\u0431\u044a\u0440\u0437\u043e, \u0438\u043b\u0438 \u0441\u0435 \u0432\u044a\u0440\u043d\u0435\u0442\u0435 \u043f\u043e-\u043a\u044a\u0441\u043d\u043e."],"Something went wrong.":["\u041d\u0435\u0449\u043e \u0441\u0435 \u043e\u0431\u044a\u0440\u043a\u0430."],"What was done so far is kept. Resume to finish the rest.":["\u0421\u0432\u044a\u0440\u0448\u0435\u043d\u043e\u0442\u043e \u0434\u043e\u0441\u0435\u0433\u0430 \u0435 \u0437\u0430\u043f\u0430\u0437\u0435\u043d\u043e. \u041f\u0440\u043e\u0434\u044a\u043b\u0436\u0435\u0442\u0435, \u0437\u0430 \u0434\u0430 \u0437\u0430\u0432\u044a\u0440\u0448\u0438\u0442\u0435 \u043e\u0441\u0442\u0430\u043d\u0430\u043b\u043e\u0442\u043e."],"Cancel":["\u041e\u0442\u043a\u0430\u0437"],"The installation could not resume.":["\u0418\u043d\u0441\u0442\u0430\u043b\u0438\u0440\u0430\u043d\u0435\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0434\u0430 \u043f\u0440\u043e\u0434\u044a\u043b\u0436\u0438."],"Cancel the installation?":["\u041e\u0442\u043c\u044f\u043d\u0430 \u043d\u0430 \u0438\u043d\u0441\u0442\u0430\u043b\u0438\u0440\u0430\u043