msgstr "Имате несачуване измене."

#: assets/build/admin/index.js:16
msgid "Discard"
msgstr "Одбаци"

#: assets/build/admin/index.js:16
msgid "Settings saved."
msgstr "Подешавања су сачувана."

#: assets/build/admin/index.js:16
msgid "The settings could not be saved."
msgstr "Чување подешавања није успело."

#: assets/build/admin/index.js:16
msgid "Save changes"
msgstr "Сачувај измене"

