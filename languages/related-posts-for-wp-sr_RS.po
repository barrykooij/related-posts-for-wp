#: assets/build/admin/index.js:13
msgid "Version %s"
msgstr "Издање %s"

#: assets/build/admin/index.js:16
msgid "Premium"
msgstr "Premium"

#: assets/build/admin/index.js:16
msgid "Related Posts settings"
msgstr "Подешавања Related Posts"

#: assets/build/admin/index.js:16
