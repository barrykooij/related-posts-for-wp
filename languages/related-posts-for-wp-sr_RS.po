msgctxt "page title"
msgid "Related Posts"
msgstr "Related Posts"

#: src/Admin/Settings/Page.php:82
msgid "The settings of Related Posts for WordPress need JavaScript."
msgstr "Подешавања додатка Related Posts for WordPress захтевају JavaScript."

#: src/Admin/Wizard/Page.php:123
msgid "Go to the settings of Related Posts for WordPress"
msgstr "Иди на подешавања додатка Related Posts for WordPress"

#: src/Frontend/Widget.php:29
