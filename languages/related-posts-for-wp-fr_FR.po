msgid "Something went wrong."
msgstr "Une erreur s’est produite."

#: assets/build/admin/index.js:13
msgid "What was done so far is kept. Resume to finish the rest."
msgstr "Le travail déjà effectué est conservé. Reprenez pour terminer le reste."

#: assets/build/admin/index.js:13
msgid "Cancel"
msgstr "Annuler"

#: assets/build/admin/index.js:13
msgid "The installation could not resume."
msgstr "Impossible de reprendre l’installation."

#: assets/build/admin/index.js:13
msgid "Resume"
msgstr "Reprendre"

#: assets/build/admin/index.js:13
msgid "Cancel the installation?"
msgstr "Annuler l’installation ?"

#: assets/build/admin/index.js:13
msgid "Cancel installation"
msgstr "Annuler l’installation"

#: assets/build/admin/index.js:13
msgid "Keep running"
msgstr "Continuer"

