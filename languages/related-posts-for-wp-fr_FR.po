msgid "The installation could not be cancelled."
msgstr "Impossible d’annuler l’installation."

#: assets/build/admin/index.js:13
msgid "What was done so far is kept, and you can resume later."
msgstr "Le travail déjà effectué est conservé, et vous pourrez reprendre plus tard."

#: assets/build/admin/index.js:13
msgid "Related posts per post"
msgstr "Articles liés par article"

#: assets/build/admin/index.js:13
msgid "Get started"
msgstr "Commencer"

