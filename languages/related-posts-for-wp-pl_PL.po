msgstr "Kroki instalacji zmieniły się w trakcie jej trwania. Prosimy uruchomić ją ponownie."

#: src/Install/Planner.php:37
msgid "The number of related posts to link to each post."
msgstr "Liczba powiązanych wpisów łączonych z każdym wpisem."

#: src/Install/Planner.php:44
msgid "Only cache the words of the posts, and link nothing."
msgstr "Zapisuje tylko słowa wpisów w pamięci podręcznej i niczego nie łączy."

#: src/Install/Planner.php:49
msgid "Remove every link and all cached words first, and install again."
msgstr "Najpierw usuwa wszystkie połączenia i wszystkie słowa z pamięci podręcznej, a potem instaluje ponownie."

#: src/Install/Tasks/CacheWordsTask.php:49
msgid "Caching posts"
msgstr "Zapisywanie wpisów w pamięci podręcznej"

#: src/Install/Tasks/LinkPostsTask.php:68
msgid "Linking posts"
msgstr "Łączenie wpisów"

#: src/Install/Tasks/ResetTask.php:35
