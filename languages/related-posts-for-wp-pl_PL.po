#: src/Settings/Schema/Pages.php:164
msgid "There is no settings page \"%s\"."
msgstr "Nie ma strony ustawień „%s”."

#: src/Settings/Settings.php:156
msgid "General"
msgstr "Ogólne"

#: src/Settings/Settings.php:157
msgid "The following options affect the general behaviour of the plugin."
msgstr "Poniższe opcje wpływają na ogólne działanie wtyczki."

#: src/Settings/Settings.php:161
msgid "Enable"
msgstr "Włącz"

#: src/Settings/Settings.php:162
msgid "Checking this will enable automatically linking posts to new posts"
msgstr "Zaznaczenie tej opcji włączy automatyczne łączenie nowych wpisów z powiązanymi wpisami"

#: src/Settings/Settings.php:168
msgid "Amount of Posts"
msgstr "Liczba wpisów"

#: src/Settings/Settings.php:169
msgid "The amount of automatically linked post"
msgstr "Liczba automatycznie łączonych wpisów"

#: src/Settings/Settings.php:178
msgid "Heading text"
msgstr "Tekst nagłówka"

#: src/Settings/Settings.php:179
msgid "The text that is displayed above the related posts. To disable, leave field empty."
msgstr "Tekst wyświetlany nad powiązanymi wpisami. Aby go wyłączyć, należy pozostawić pole puste."

#: src/Settings/Settings.php:185
msgid "Excerpt length"
msgstr "Długość zajawki"

#: src/Settings/Settings.php:186
msgid "The amount of words to be displayed below the title on website. To disable, set value to 0."
msgstr "Liczba słów wyświetlanych pod tytułem w witrynie. Aby wyłączyć, należy ustawić wartość 0."

#: src/Settings/Settings.php:196
msgid "Styling"
msgstr "Wygląd"

#: src/Settings/Settings.php:197
msgid "The following options affect how related posts are displayed on the frontend."
msgstr "Poniższe opcje wpływają na sposób wyświetlania powiązanych wpisów w witrynie."

#: src/Settings/Settings.php:201
msgid "Display Image"
msgstr "Wyświetlanie obrazka"

#: src/Settings/Settings.php:202
msgid "Checking this will enable displaying featured images of related posts."
msgstr "Zaznaczenie tej opcji włączy wyświetlanie obrazków wyróżniających powiązanych wpisów."

#: src/Settings/Settings.php:208
msgid "CSS"
msgstr "CSS"

#: src/Settings/Settings.php:209
msgid "Warning! This is an advanced feature! An error here will break frontend display. To disable, leave field empty."
msgstr "Uwaga! To jest funkcja zaawansowana! Błąd w tym miejscu zepsuje wyświetlanie w witrynie. Aby wyłączyć, należy pozostawić pole puste."

#: src/Settings/Settings.php:218
msgid "Misc"
msgstr "Różne"

#: src/Settings/Settings.php:219
msgid "A shelter for options that just don't fit in anywhere else."
msgstr "Miejsce na opcje, które nie pasują nigdzie indziej."

#: src/Settings/Settings.php:223
msgid "Remove Data on Uninstall?"
msgstr "Usunąć dane przy odinstalowaniu?"

#: src/Settings/Settings.php:224
msgid "Check this box if you would like to completely remove all of its data when the plugin is deleted."
msgstr "Po zaznaczeniu tego pola wszystkie dane wtyczki zostaną całkowicie usunięte podczas jej usuwania."

#: src/Settings/Settings.php:230
msgid "Show love?"
msgstr "Okazać wsparcie?"

#: src/Settings/Settings.php:231
msgid "Display a 'Powered by' line under your related posts. <strong>BEWARE! Only for the real fans.</strong>"
msgstr "Wyświetla wiersz „Powered by” pod powiązanymi wpisami. <strong>UWAGA! Tylko dla prawdziwych fanów.</strong>"

#: assets/build/admin/index.js:1
msgid "The settings could not be loaded."
msgstr "Nie udało się wczytać ustawień."

#: assets/build/admin/index.js:1
msgid "The installer could not be reached."
msgstr "Instalator jest niedostępny."

#: assets/build/admin/index.js:1
msgid "All set! Your posts are linked."
msgstr "Gotowe! Wpisy zostały połączone."

#: assets/build/admin/index.js:1
msgid "All set! Your posts are read."
msgstr "Gotowe! Wpisy zostały odczytane."

#: assets/build/admin/index.js:1
msgid "Every post shows its related posts now, and new posts are linked when you publish them."
msgstr "Każdy wpis wyświetla teraz swoje powiązane wpisy, a nowe wpisy są łączone w momencie publikacji."

#: assets/build/admin/index.js:1
msgid "Link them from the Installer tab when you are ready."
msgstr "Wpisy można połączyć później na karcie Instalator."

#: assets/build/admin/index.js:1
msgid "Close"
msgstr "Zamknij"

#: assets/build/admin/index.js:1
msgid "Less than a minute left"
msgstr "Pozostała niecała minuta"

#. translators: %s: a number of minutes
#: assets/build/admin/index.js:4
msgid "About %s minute left"
msgid_plural "About %s minutes left"
msgstr[0] "Pozostała mniej więcej %s minuta"
msgstr[1] "Pozostały mniej więcej %s minuty"
msgstr[2] "Pozostało mniej więcej %s minut"

#. translators: 1: posts done, 2: all posts
#: assets/build/admin/index.js:7
msgid "%1$s of %2$s posts"
msgstr "%1$s z %2$s wpisów"

#: assets/build/admin/index.js:7
msgid "The installation stopped"
msgstr "Instalacja została zatrzymana"

#: assets/build/admin/index.js:7
msgid "The installation was cancelled"
msgstr "Instalacja została anulowana"

#: assets/build/admin/index.js:7
msgid "Linking your related posts"
msgstr "Łączenie powiązanych wpisów"

#: assets/build/admin/index.js:7
msgid "This runs in the background. You can leave this page; it goes on without you."
msgstr "Działa to w tle. Można opuścić tę stronę; instalacja będzie kontynuowana."

#. translators: %d: how far the installation is, in percent
#: assets/build/admin/index.js:10
msgid "%d%%"
msgstr "%d%%"

#: assets/build/admin/index.js:10
msgid "Installation progress"
msgstr "Postęp instalacji"

#: assets/build/admin/index.js:10
msgid "Background processing is slow on this site, so this page is doing the work now. Keep it open to finish sooner, or come back later."
msgstr "Przetwarzanie w tle działa w tej witrynie wolno, więc teraz pracę wykonuje ta strona. Pozostawienie jej otwartej przyspieszy zakończenie; można też wrócić później."

#: assets/build/admin/index.js:10
msgid "Something went wrong."
msgstr "Coś poszło nie tak."

#: assets/build/admin/index.js:10
msgid "What was done so far is kept. Resume to finish the rest."
msgstr "Dotychczasowa praca została zachowana. Wznów, aby dokończyć resztę."

#: assets/build/admin/index.js:10
msgid "Cancel"
msgstr "Anuluj"

#: assets/build/admin/index.js:10
msgid "The installation could not resume."
msgstr "Nie udało się wznowić instalacji."

#: assets/build/admin/index.js:10
msgid "Resume"
msgstr "Wznów"

#: assets/build/admin/index.js:10
msgid "Cancel the installation?"
msgstr "Anulować instalację?"

#: assets/build/admin/index.js:10
msgid "Cancel installation"
msgstr "Anuluj instalację"

#: assets/build/admin/index.js:10
msgid "Keep running"
msgstr "Kontynuuj"

#: assets/build/admin/index.js:10
msgid "The installation could not be cancelled."
msgstr "Nie udało się anulować instalacji."

#: assets/build/admin/index.js:10
msgid "What was done so far is kept, and you can resume later."
msgstr "Dotychczasowa praca została zachowana, a instalację można wznowić później."

#: assets/build/admin/index.js:10
msgid "Related posts per post"
msgstr "Liczba powiązanych wpisów na wpis"

#: assets/build/admin/index.js:10
msgid "Get started"
msgstr "Pierwsze kroki"

#: assets/build/admin/index.js:10
msgid "Let's link your related posts"
msgstr "Połączmy powiązane wpisy"

#: assets/build/admin/index.js:10
msgid "Related Posts reads your posts once to learn what each one is about, then links every post to the posts that are most related to it."
msgstr "Related Posts jednorazowo odczytuje wpisy, aby poznać tematykę każdego z nich, a następnie łączy każdy wpis z najbardziej powiązanymi wpisami."

#: assets/build/admin/index.js:10
msgid "It runs in the background, so you can leave this page while it works."
msgstr "Działa to w tle, więc w trakcie pracy można opuścić tę stronę."

#: assets/build/admin/index.js:10
msgid "You can change this later, and link again at any time."
msgstr "Można to zmienić później i w każdej chwili ponownie połączyć wpisy."

#: assets/build/admin/index.js:10
msgid "Link the posts right away"
msgstr "Połącz wpisy od razu"

#: assets/build/admin/index.js:10
msgid "Turn this off to only read the posts now, and link them later from the Installer tab."
msgstr "Po wyłączeniu tej opcji wpisy zostaną teraz tylko odczytane, a połączyć je będzie można później na karcie Instalator."

#: assets/build/admin/index.js:10 assets/build/admin/index.js:16
msgid "The installation could not start."
msgstr "Nie udało się uruchomić instalacji."

#: assets/build/admin/index.js:10
msgid "Start"
msgstr "Rozpocznij"

#: assets/build/admin/index.js:10
msgid "The installation is done."
msgstr "Instalacja została zakończona."

#: assets/build/admin/index.js:10
msgid "The installation stopped."
msgstr "Instalacja została zatrzymana."

#. translators: %s: the plugin version
#: assets/build/admin/index.js:13
msgid "Version %s"
msgstr "Wersja %s"

#: assets/build/admin/index.js:16
msgid "Premium"
msgstr "Premium"

#: assets/build/admin/index.js:16
msgid "Related Posts settings"
msgstr "Ustawienia Related Posts"

#: assets/build/admin/index.js:16
msgid "Unsaved changes"
msgstr "Niezapisane zmiany"

#: assets/build/admin/index.js:16
msgid "You have unsaved changes."
msgstr "Wprowadzone zmiany nie zostały zapisane."

#: assets/build/admin/index.js:16
msgid "Discard"
msgstr "Odrzuć"

#: assets/build/admin/index.js:16
msgid "Settings saved."
msgstr "Ustawienia zostały zapisane."

#: assets/build/admin/index.js:16
msgid "The settings could not be saved."
msgstr "Nie udało się zapisać ustawień."

#: assets/build/admin/index.js:16
msgid "Save changes"
msgstr "Zapisz zmiany"

#: assets/build/admin/index.js:16
msgid "This page does not exist."
msgstr "Ta strona nie istnieje."

#: assets/build/admin/index.js:16
msgid "This option is overwritten by a filter."
msgstr "Ta opcja jest nadpisana przez filtr."

#: assets/build/admin/index.js:16
msgid "Installer"
msgstr "Instalator"

#: assets/build/admin/index.js:16
msgid "An installation is running. You can start another one when it is done."
msgstr "Instalacja jest w toku. Nową można rozpocząć po jej zakończeniu."

#: assets/build/admin/index.js:16
msgid "Link new posts"
msgstr "Połącz nowe wpisy"

#: assets/build/admin/index.js:16
msgid "Read and link the posts that are not linked yet, for example posts from before automatic linking was on. Links that exist stay as they are."
msgstr "Odczytuje i łączy wpisy, które nie są jeszcze połączone, na przykład wpisy sprzed włączenia automatycznego łączenia. Istniejące połączenia pozostają bez zmian."

#: assets/build/admin/index.js:16
msgid "Rebuild everything"
msgstr "Zbuduj wszystko od nowa"

#: assets/build/admin/index.js:16
msgid "Start over: remove every related post link, also the links you added by hand, read all posts again and link them. Your posts themselves are never touched."
msgstr "Zaczyna od nowa: usuwa każde połączenie z powiązanymi wpisami, także te dodane ręcznie, ponownie odczytuje wszystkie wpisy i je łączy. Same wpisy nigdy nie są zmieniane."

#: assets/build/admin/index.js:16
msgid "Rebuild everything?"
msgstr "Zbudować wszystko od nowa?"

#: assets/build/admin/index.js:16
msgid "Remove links and rebuild"
msgstr "Usuń połączenia i zbuduj od nowa"

#: assets/build/admin/index.js:16
msgid "Keep my links"
msgstr "Zachowaj moje połączenia"

#: assets/build/admin/index.js:16
msgid "Every related post link is removed, including the links you added by hand. This can not be undone."
msgstr "Każde połączenie z powiązanymi wpisami zostanie usunięte, także te dodane ręcznie. Tej operacji nie można cofnąć."
