30\u0432\u0440\u0448\u0435\u043d\u0430."],"The installation stopped.":["\u0418\u043d\u0441\u0442\u0430\u043b\u0430\u0446\u0438\u0458\u0430 \u0458\u0435 \u0437\u0430\u0443\u0441\u0442\u0430\u0432\u0459\u0435\u043d\u0430."],"Version %s":["\u0418\u0437\u0434\u0430\u045a\u0435 %s"],"Premium":["Premium"],"Related Posts settings":["\u041f\u043e\u0434\u0435\u0448\u0430\u0432\u0430\u045a\u0430 Related Posts"],"Unsaved changes":["\u041d\u0435\u0441\u0430\u0447\u0443\u0432\u0430\u043d\u0435 \u0438\u0437\u043c\u0435\u043d\u0435"],"You have unsaved changes.":["\u0418\u043c\u0430\u0442\u0435 \u043d\u0435\u0441\u0430\u0447\u0443\u0432\u0430\u043d\u0435 \u0438\u0437\u043c\u0435\u043d\u0435."],"Discard":["\u041e\u0434\u0431\u0430\u0446\u0438"],"Settings saved.":["\u041f\u043e\u0434\u0435\u0448\u0430\u0432\u0430\u045a\u0430 \u0441\u0443 \u0441\u0430\u0447\u0443\u0432\u0430\u043d\u0430."],"The settings could not be saved.":["\u0427\u0443\u0432\u0430\u045a\u0435 \u043f\u043e\u0434\u0435\u0448\u0430\u0432\u0430\u045a\u0430 \u043d\u0438\u0458\u0435 \u0443\u0441\u043f\u0435\u043b\u043e."],"Save changes":["\u0421\u0430\u0447\u0443\u0432\u0430\u0458 \u0438\u0437\u043c\u0435\u043d\u0435"],"More about Related Posts":["\u0412\u0438\u0448\u0435 \u043e Related Posts"],"Design the layout in the visual configurator":["\u041e\u0441\u043c\u0438\u0441\u043b\u0438\u0442\u0435 \u0438\u0437\u0433\u043b\u0435\u0434 \u0443 \u0432\u0438\u0437\u0443\u0435\u043b\u043d\u043e\u043c \u043a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0430\u0442\u043e\u0440\u0443"],"Relate pages, products and custom post types":["\u041f\u043e\u0432\u0435\u0436\u0438\u0442\u0435 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0435, \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0435 \u0438 \u043f\u0440\u0438\u043b\u0430\u0433\u043e\u0452\u0435\u043d\u0435 \u0432\u0440\u0441\u0442\u0435 \u0447\u043b\u0430\u043d\u0430\u043a\u0430"],"Choose what counts with adjustable weights":["\u0418\u0437\u0430\u0431\u0435\u0440\u0438\u0442\u0435 \u0448\u0442\u0430 \u0441\u0435 \u0440\u0430\u0447\u0443\u043d\u0430 \u043f\u043e\u043c\u043e\u045b\u0443 \u043f\u043e\u0434\u0435\u0441\u0438\u0432\u0438\u0445 \u0442\u0435\u0436\u0438\u043d\u0430"],"Exclude posts and whole categories":["\u0418\u0441\u043a\u0459\u0443\u0447\u0438\u0442\u0435 \u0447\u043b\u0430\u043d\u043a\u0435 \u0438 \u0446\u0435\u043b\u0435 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0458\u0435"],"Older posts get your new posts too":["\u0421\u0442\u0430\u0440\u0438\u0458\u0438 \u0447\u043b\u0430\u043d\u0446\u0438 \u0434\u043e\u0431\u0438\u0458\u0430\u0458\u0443 \u0438 \u0432\u0430\u0448\u0435 \u043d\u043e\u0432\u0435 \u0447\u043b\u0430\u043d\u043a\u0435"],"See why posts are related":["\u041f\u043e\u0433\u043b\u0435\u0434\u0430\u0458\u0442\u0435 \u0437\u0430\u0448\u0442\u043e \u0441\u0443 \u0447\u043b\u0430\u043d\u0446\u0438 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u0438"],"Priority email support":["\u041f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u043d\u0430 \u043f\u043e\u0434\u0440\u0448\u043a\u0430 \u0435-\u043f\u043e\u0448\u0442\u043e\u043c"],"Take your related posts further":["\u0418\u0437\u0432\u0443\u0446\u0438\u0442\u0435 \u0432\u0438\u0448\u0435 \u0438\u0437 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u0438\u0445 \u0447\u043b\u0430\u043d\u0430\u043a\u0430"],"Premium gives you control over what gets related and how it looks. It is an add-on for this plugin, so your settings and links stay as they are.":["Premium \u0432\u0430\u043c \u0434\u0430\u0458\u0435 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0443 \u043d\u0430\u0434 \u0442\u0438\u043c \u0448\u0442\u0430 \u0441\u0435 \u043f\u043e\u0432\u0435\u0437\u0443\u0458\u0435 \u0438 \u043a\u0430\u043a\u043e \u0438\u0437\u0433\u043b\u0435\u0434\u0430. \u0422\u043e \u0458\u0435 \u043f\u0440\u043e\u0448\u0438\u0440\u0435\u045a\u0435 \u043e\u0432\u043e\u0433 \u0434\u043e\u0434\u0430\u0442\u043a\u0430, \u043f\u0430 \u0432\u0430\u0448\u0430 \u043f\u043e\u0434\u0435\u0448\u0430\u0432\u0430\u045a\u0430 \u0438 \u0432\u0435\u0437\u0435 \u043e\u0441\u0442\u0430\u0458\u0443 \u043a\u0430\u043a\u0432\u0438 \u0458\u0435\u0441\u0443."],"See all features":["\u041f\u043e\u0433\u043b\u0435\u0434\u0430\u0458\u0442\u0435 \u0441\u0432\u0435 \u043c\u043e\u0433\u0443\u045b\u043d\u043e\u0441\u0442\u0438"],"14 day money back guarantee":["\u0413\u0430\u0440\u0430\u043d\u0446\u0438\u0458\u0430 \u043f\u043e\u0432\u0440\u0430\u045b\u0430\u0458\u0430 \u043d\u043e\u0432\u0446\u0430 \u043e\u0434 14 \u0434\u0430\u043d\u0430"],"Getting started":["\u041f\u0440\u0432\u0438 \u043a\u043e\u0440\u0430\u0446\u0438"],"Show related posts in your theme":["\u041f\u0440\u0438\u043a\u0430\u0437 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u0438\u0445 \u0447\u043b\u0430\u043d\u0430\u043a\u0430 \u0443 \u0442\u0435\u043c\u0438"],"Style the related posts with CSS":["\u0421\u0442\u0438\u043b\u0438\u0437\u043e\u0432\u0430\u045a\u0435 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u0438\u0445 \u0447\u043b\u0430\u043d\u0430\u043a\u0430 \u043f\u043e\u043c\u043e\u045b\u0443 CSS-\u0430"],"All documentation":["\u0421\u0432\u0430 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u0458\u0430"],"Need help?":["\u041f\u043e\u0442\u0440\u0435\u0431\u043d\u0430 \u0432\u0430\u043c \u0458\u0435 \u043f\u043e\u043c\u043e\u045b?"],"The documentation answers most questions.":["\u0414\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u0458\u0430 \u043e\u0434\u0433\u043e\u0432\u0430\u0440\u0430 \u043d\u0430 \u0432\u0435\u045b\u0438\u043d\u0443 \u043f\u0438\u0442\u0430\u045a\u0430."],"Ask on the support forum":["\u041f\u0438\u0442\u0430\u0458\u0442\u0435 \u043d\u0430 \u0444\u043e\u0440\u0443\u043c\u0443 \u043f\u043e\u0434\u0440\u0448\u043a\u0435"],"Enjoying Related Posts?":["\u0421\u0432\u0438\u0452\u0430 \u0432\u0430\u043c \u0441\u0435 Related Posts?"],"A review on WordPress.org helps other people find the plugin, and keeps it going.":["\u0420\u0435\u0446\u0435\u043d\u0437\u0438\u0458\u0430 \u043d\u0430 WordPress.org \u043f\u043e\u043c\u0430\u0436\u0435 \u0434\u0440\u0443\u0433\u0438\u043c\u0430 \u0434\u0430 \u043f\u0440\u043e\u043d\u0430\u0452\u0443 \u0434\u043e\u0434\u0430\u0442\u0430\u043a \u0438 \u043e\u0434\u0440\u0436\u0430\u0432\u0430 \u0433\u0430 \u0443 \u0436\u0438\u0432\u043e\u0442\u0443."],"Leave a review":["\u041d\u0430\u043f\u0438\u0448\u0438\u0442\u0435 \u0440\u0435\u0446\u0435\u043d\u0437\u0438\u0458\u0443"],"This page does not exist.":["\u041e\u0432\u0430 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u043d\u0435 \u043f\u043e\u0441\u0442\u043e\u0458\u0438."],"Restore default":["\u0412\u0440\u0430\u0442\u0438 \u043f\u043e\u0434\u0440\u0430\u0437\u0443\u043c\u0435\u0432\u0430\u043d\u043e"],"This option is overwritten by a filter.":["\u041e\u0432\u0443 \u043e\u043f\u0446\u0438\u0458\u0443 \u0437\u0430\u043c\u0435\u045a\u0443\u0458\u0435 \u0444\u0438\u043b\u0442\u0435\u0440."],"An installation is running. You can start another one when it is done.":["\u0418\u043d\u0441\u0442\u0430\u043b\u0430\u0446\u0438\u0458\u0430 \u0458\u0435 \u0443 \u0442\u043e\u043a\u0443. \u041d\u043e\u0432\u0443 \u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u043e\u043a\u0440\u0435\u043d\u0443\u0442\u0438 \u043a\u0430\u0434\u0430 \u0441\u0435 \u043e\u043d\u0430 \u0437\u0430\u0432\u0440\u0448\u0438."],"Link new posts":["\u041f\u043e\u0432\u0435\u0436\u0438 \u043d\u043e\u0432\u0435 \u0447\u043b\u0430\u043d\u043a\u0435"],"Read and link the posts that are not linked yet, for example posts from before automatic linking was on. Links that exist stay as they are.":["\u0427\u0438\u0442\u0430 \u0438 \u043f\u043e\u0432\u0435\u0437\u0443\u0458\u0435 \u0447\u043b\u0430\u043d\u043a\u0435 \u043a\u043e\u0458\u0438 \u0458\u043e\u0448 \u043d\u0438\u0441\u0443 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u0438, \u043d\u0430 \u043f\u0440\u0438\u043c\u0435\u0440 \u0447\u043b\u0430\u043d\u043a\u0435 \u043d\u0430\u0441\u0442\u0430\u043b\u0435 \u043f\u0440\u0435 \u043d\u0435\u0433\u043e \u0448\u0442\u043e \u0458\u0435 \u0430\u0443\u0442\u043e\u043c\u0430\u0442\u0441\u043a\u043e \u043f\u043e\u0432\u0435\u0437\u0438\u0432\u0430\u045a\u0435 \u0443\u043a\u0459\u0443\u0447\u0435\u043d\u043e. \u041f\u043e\u0441\u0442\u043e\u0458\u0435\u045b\u0435 \u0432\u0435\u0437\u0435 \u043e\u0441\u0442\u0430\u0458\u0443 \u043d\u0435\u043f\u0440\u043e\u043c\u0435\u045a\u0435\u043d\u0435."],"Rebuild everything":["\u041f\u043e\u043d\u043e\u0432\u043e \u0438\u0437\u0433\u0440\u0430\u0434\u0438 \u0441\u0432\u0435"],"Start over: remove the automatic related post links, read all posts again and link them. Links you added by hand stay, and your posts themselves are never touched.":["\u0421\u0432\u0435 \u0438\u0437 \u043f\u043e\u0447\u0435\u0442\u043a\u0430: \u0443\u043a\u043b\u0430\u045a\u0430 \u0430\u0443\u0442\u043e\u043c\u0430\u0442\u0441\u043a\u0435 \u0432\u0435\u0437\u0435 \u043a\u0430 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u0438\u043c \u0447\u043b\u0430\u043d\u0446\u0438\u043c\u0430, \u043f\u0430 \u043f\u043e\u043d\u043e\u0432\u043e \u0447\u0438\u0442\u0430 \u0438 \u043f\u043e\u0432\u0435\u0437\u0443\u0458\u0435 \u0441\u0432\u0435 \u0447\u043b\u0430\u043d\u043a\u0435. \u0412\u0435\u0437\u0435 \u043a\u043e\u0458\u0435 \u0441\u0442\u0435 \u0440\u0443\u0447\u043d\u043e \u0434\u043e\u0434\u0430\u043b\u0438 \u0441\u0435 \u0437\u0430\u0434\u0440\u0436\u0430\u0432\u0430\u0458\u0443, \u0430 \u0441\u0430\u043c\u0438 \u0447\u043b\u0430\u043d\u0446\u0438 \u043e\u0441\u0442\u0430\u0458\u0443 \u043d\u0435\u0442\u0430\u043a\u043d\u0443\u0442\u0438."],"Rebuild everything?":["\u041f\u043e\u043d\u043e\u0432\u043e \u0438\u0437\u0433\u0440\u0430\u0434\u0438\u0442\u0438 \u0441\u0432\u0435?"],"Remove links and rebuild":["\u0423\u043a\u043b\u043e\u043d\u0438 \u0432\u0435\u0437\u0435 \u0438 \u043f\u043e\u043d\u043e\u0432\u043e \u0438\u0437\u0433\u0440\u0430\u0434\u0438"],"Keep my links":["\u0417\u0430\u0434\u0440\u0436\u0438 \u043c\u043e\u0458\u0435 \u0432\u0435\u0437\u0435"],"The automatic related post links of every post type are removed, and all posts are read and linked again. Links you added by hand stay.":["\u0410\u0443\u0442\u043e\u043c\u0430\u0442\u0441\u043a\u0435 \u0432\u0435\u0437\u0435 \u043a\u0430 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u0438\u043c \u0447\u043b\u0430\u043d\u0446\u0438\u043c\u0430 \u0437\u0430 \u0441\u0432\u0435 \u0432\u0440\u0441\u0442\u0435 \u0447\u043b\u0430\u043d\u0430\u043a\u0430 \u0431\u0438\u045b\u0435 \u0443\u043a\u043b\u043e\u045a\u0435\u043d\u0435, \u0430 \u0441\u0432\u0438 \u0447\u043b\u0430\u043d\u0446\u0438 \u0431\u0438\u045b\u0435 \u043f\u043e\u043d\u043e\u0432\u043e \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043d\u0438 \u0438 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u0438. \u0412\u0435\u0437\u0435 \u043a\u043e\u0458\u0435 \u0441\u0442\u0435 \u0440\u0443\u0447\u043d\u043e \u0434\u043e\u0434\u0430\u043b\u0438 \u043e\u0441\u0442\u0430\u0458\u0443."]}}}