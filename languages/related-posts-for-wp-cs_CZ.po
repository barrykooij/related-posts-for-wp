#: assets/build/admin/index.js:13
msgid "%1$s of %2$s posts"
msgstr "%1$s z %2$s příspěvků"

#: assets/build/admin/index.js:13
msgid "The installation stopped"
msgstr "Instalace se zastavila"

#: assets/build/admin/index.js:13
msgid "The installation was cancelled"
msgstr "Instalace byla zrušena"

#: assets/build/admin/index.js:13
msgid "Linking your related posts"
msgstr "Propojování vašich souvisejících příspěvků"

#: assets/build/admin/index.js:13
msgid "This runs in the background. You can leave this page; it goes on without you."
msgstr "Probíhá to na pozadí. Tuto stránku můžete opustit; vše poběží dál i bez vás."

#. translators: %d: how far the installation is, in percent
#: assets/build/admin/index.js:16
msgid "%d%%"
msgstr "%d %%"

#: assets/build/admin/index.js:16
msgid "Installation progress"
msgstr "Průběh instalace"

#: assets/build/admin/index.js:16
msgid "Background processing is slow on this site, so this page is doing the work now. Keep it open to finish sooner, or come back later."
msgstr "Úlohy na pozadí jsou na tomto webu pomalé, takže práci teď vykonává tato stránka. Nechte ji otevřenou, aby vše skončilo dříve, nebo se vraťte později."

#: assets/build/admin/index.js:16
msgid "Something went wrong."
msgstr "Něco se pokazilo."

#: assets/build/admin/index.js:16
msgid "What was done so far is kept. Resume to finish the rest."
msgstr "Vše, co už bylo hotovo, zůstane zachováno. Pokračováním dokončíte zbytek."

#: assets/build/admin/index.js:16
msgid "Cancel"
msgstr "Zrušit"

#: assets/build/admin/index.js:16
msgid "The installation could not resume."
msgstr "V instalaci se nepodařilo pokračovat."

#: assets/build/admin/index.js:16
msgid "Resume"
msgstr "Pokračovat"

#: assets/build/admin/index.js:16
msgid "Cancel the installation?"
msgstr "Zrušit instalaci?"

#: assets/build/admin/index.js:16
msgid "Cancel installation"
msgstr "Zrušit instalaci"

#: assets/build/admin/index.js:16
msgid "Keep running"
msgstr "Nechat běžet"

#: assets/build/admin/index.js:16
msgid "The installation could not be cancelled."
msgstr "Instalaci se nepodařilo zrušit."

#: assets/build/admin/index.js:16
msgid "What was done so far is kept, and you can resume later."
msgstr "Vše, co už bylo hotovo, zůstane zachováno a pokračovat můžete později."

#: assets/build/admin/index.js:16
msgid "Related posts per post"
msgstr "Počet souvisejících příspěvků u příspěvku"

#: assets/build/admin/index.js:16
msgid "Get started"
msgstr "Začínáme"

#: assets/build/admin/index.js:16
msgid "Let's link your related posts"
msgstr "Pojďme propojit vaše související příspěvky"

#: assets/build/admin/index.js:16
msgid "Related Posts reads your posts once to learn what each one is about, then links every post to the posts that are most related to it."
msgstr "Related Posts jednou přečte vaše příspěvky, aby zjistil, o čem každý z nich je, a pak propojí každý příspěvek s příspěvky, které s ním nejvíce souvisejí."

#: assets/build/admin/index.js:16
msgid "It runs in the background, so you can leave this page while it works."
msgstr "Probíhá to na pozadí, takže tuto stránku můžete mezitím opustit."

#: assets/build/admin/index.js:16
msgid "You can change this later, and link again at any time."
msgstr "Později to můžete změnit a kdykoli propojit znovu."

#: assets/build/admin/index.js:16
msgid "Link the posts right away"
msgstr "Propojit příspěvky hned"

#. translators: %s: the name of a tab of the settings screen, for example Installer
#: assets/build/admin/index.js:19
msgid "Turn this off to only read the posts now, and link them later from the %s tab."
msgstr "Vypněte, chcete-li příspěvky teď jen přečíst a propojit je později na kartě %s."

#: assets/build/admin/index.js:19 assets/build/admin/index.js:25
msgid "The installation could not start."
msgstr "Instalaci se nepodařilo spustit."

#: assets/build/admin/index.js:19
msgid "Start"
msgstr "Spustit"

#: assets/build/admin/index.js:19
msgid "The installation is done."
msgstr "Instalace je dokončena."

#: assets/build/admin/index.js:19
msgid "The installation stopped."
msgstr "Instalace se zastavila."

#. translators: %s: the plugin version
#: assets/build/admin/index.js:22
msgid "Version %s"
msgstr "Verze %s"

#: assets/build/admin/index.js:25
msgid "Premium"
msgstr "Premium"

#: assets/build/admin/index.js:25
msgid "Related Posts settings"
msgstr "Nastavení Related Posts"

#: assets/build/admin/index.js:25
msgid "Unsaved changes"
msgstr "Neuložené změny"

#: assets/build/admin/index.js:25
msgid "You have unsaved changes."
msgstr "Máte neuložené změny."

#: assets/build/admin/index.js:25
msgid "Discard"
msgstr "Zahodit"

#: assets/build/admin/index.js:25
msgid "Settings saved."
msgstr "Nastavení bylo uloženo."

#: assets/build/admin/index.js:25
msgid "The settings could not be saved."
msgstr "Nastavení se nepodařilo uložit."

#: assets/build/admin/index.js:25
msgid "Save changes"
msgstr "Uložit změny"

#: assets/build/admin/index.js:25
msgid "This page does not exist."
msgstr "Tato stránka neexistuje."

#: assets/build/admin/index.js:25
msgid "This option is overwritten by a filter."
msgstr "Tato možnost je přepsána filtrem."

#: assets/build/admin/index.js:25
msgid "An installation is running. You can start another one when it is done."
msgstr "Probíhá instalace. Další můžete spustit, až bude dokončena."

#: assets/build/admin/index.js:25
msgid "Link new posts"
msgstr "Propojit nové příspěvky"

#: assets/build/admin/index.js:25
msgid "Read and link the posts that are not linked yet, for example posts from before automatic linking was on. Links that exist stay as they are."
msgstr "Přečte a propojí příspěvky, které ještě nejsou propojené, například příspěvky z doby před zapnutím automatického propojování. Stávající propojení zůstanou beze změny."

#: assets/build/admin/index.js:25
msgid "Rebuild everything"
msgstr "Vše znovu sestavit"

#: assets/build/admin/index.js:25
msgid "Start over: remove every related post link, also the links you added by hand, read all posts again and link them. Your posts themselves are never touched."
msgstr "Začít znovu: odstraní všechna propojení souvisejících příspěvků, včetně těch, která jste přidali ručně, znovu přečte všechny příspěvky a propojí je. Samotné příspěvky zůstanou vždy nedotčené."

#: assets/build/admin/index.js:25
msgid "Rebuild everything?"
msgstr "Vše znovu sestavit?"

#: assets/build/admin/index.js:25
msgid "Remove links and rebuild"
msgstr "Odstranit propojení a sestavit znovu"

#: assets/build/admin/index.js:25
msgid "Keep my links"
msgstr "Ponechat moje propojení"

