#: assets/build/admin/index.js:19
msgid "Version %s"
msgstr "Версия %s"

#: assets/build/admin/index.js:22
msgid "Premium"
msgstr "Premium"

#: assets/build/admin/index.js:22
msgid "Related Posts settings"
msgstr "Настройки Related Posts"

#: assets/build/admin/index.js:22
msgid "Unsaved changes"
msgstr "Несохранённые изменения"

#: assets/build/admin/index.js:22
msgid "You have unsaved changes."
msgstr "У вас есть несохранённые изменения."

#: assets/build/admin/index.js:22
