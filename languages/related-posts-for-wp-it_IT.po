msgstr "Installer"

#: assets/build/admin/index.js:1
msgid "All set! Your posts are linked."
msgstr "Fatto! I tuoi articoli sono collegati."

#: assets/build/admin/index.js:1
msgid "All set! Your posts are read."
msgstr "Fatto! I tuoi articoli sono stati letti."

#: assets/build/admin/index.js:1
msgid "Every post shows its related posts now, and new posts are linked when you publish them."
msgstr "Ora ogni articolo mostra i suoi articoli correlati, e i nuovi articoli vengono collegati quando li pubblichi."

#. translators: %s: the name of a tab of the settings screen, for example Installer
#: assets/build/admin/index.js:4
msgid "Link them from the %s tab when you are ready."
msgstr "Collegali dalla scheda %s quando sei pronto."

#: assets/build/admin/index.js:4
msgid "Close"
msgstr "Chiudi"

#: assets/build/admin/index.js:4
msgid "Less than a minute left"
msgstr "Manca meno di un minuto"

#. translators: %s: a number of minutes
#: assets/build/admin/index.js:7
msgid "About %s minute left"
msgid_plural "About %s minutes left"
msgstr[0] "Manca circa %s minuto"
msgstr[1] "Mancano circa %s minuti"

