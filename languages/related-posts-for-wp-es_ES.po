msgstr "Instalador"

#: assets/build/admin/index.js:16
msgid "An installation is running. You can start another one when it is done."
msgstr "Hay una instalación en curso. Podrás iniciar otra cuando termine."

#: assets/build/admin/index.js:16
msgid "Link new posts"
msgstr "Enlazar entradas nuevas"

