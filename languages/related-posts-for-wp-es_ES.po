msgstr "Descartar"

#: assets/build/admin/index.js:16
msgid "Settings saved."
msgstr "Ajustes guardados."

#: assets/build/admin/index.js:16
msgid "The settings could not be saved."
msgstr "No se han podido guardar los ajustes."

#: assets/build/admin/index.js:16
msgid "Save changes"
msgstr "Guardar los cambios"

