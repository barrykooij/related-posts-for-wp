msgid "Something went wrong."
msgstr "Algo ha salido mal."

#: assets/build/admin/index.js:10
msgid "What was done so far is kept. Resume to finish the rest."
msgstr "Lo que ya se ha hecho se conserva. Reanuda para terminar el resto."

#: assets/build/admin/index.js:10
msgid "Cancel"
msgstr "Cancelar"

#: assets/build/admin/index.js:10
msgid "The installation could not resume."
msgstr "No se ha podido reanudar la instalación."

#: assets/build/admin/index.js:10
msgid "Resume"
msgstr "Reanudar"

#: assets/build/admin/index.js:10
msgid "Cancel the installation?"
msgstr "¿Cancelar la instalación?"

#: assets/build/admin/index.js:10
msgid "Cancel installation"
msgstr "Cancelar instalación"

#: assets/build/admin/index.js:10
msgid "Keep running"
msgstr "Continuar"

#: assets/build/admin/index.js:10
msgid "The installation could not be cancelled."
msgstr "No se ha podido cancelar la instalación."

#: assets/build/admin/index.js:10
msgid "What was done so far is kept, and you can resume later."
msgstr "Lo que ya se ha hecho se conserva, y puedes reanudarla más tarde."

#: assets/build/admin/index.js:10
msgid "Related posts per post"
msgstr "Entradas relacionadas por entrada"

#: assets/build/admin/index.js:10
msgid "Get started"
msgstr "Primeros pasos"

#: assets/build/admin/index.js:10
msgid "Let's link your related posts"
msgstr "Vamos a enlazar tus entradas relacionadas"

#: assets/build/admin/index.js:10
msgid "Related Posts reads your posts once to learn what each one is about, then links every post to the posts that are most related to it."
msgstr "Related Posts lee tus entradas una vez para saber de qué trata cada una y, después, enlaza cada entrada con las entradas más relacionadas con ella."

#: assets/build/admin/index.js:10
msgid "It runs in the background, so you can leave this page while it works."
msgstr "Se ejecuta en segundo plano, así que puedes salir de esta página mientras trabaja."

#: assets/build/admin/index.js:10
msgid "You can change this later, and link again at any time."
msgstr "Puedes cambiarlo más tarde y volver a enlazar en cualquier momento."

#: assets/build/admin/index.js:10
msgid "Link the posts right away"
msgstr "Enlazar las entradas ahora mismo"

#: assets/build/admin/index.js:10
msgid "Turn this off to only read the posts now, and link them later from the Installer tab."
msgstr "Desactívalo para solo leer las entradas ahora y enlazarlas más tarde desde la pestaña Instalador."

