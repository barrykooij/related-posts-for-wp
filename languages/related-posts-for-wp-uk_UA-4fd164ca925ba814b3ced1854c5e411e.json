 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0438 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f."],"Start":["\u041f\u043e\u0447\u0430\u0442\u0438"],"The installation is done.":["\u0412\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043e."],"The installation stopped.":["\u0412\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0437\u0443\u043f\u0438\u043d\u0438\u043b\u043e\u0441\u044f."],"Version %s":["\u0412\u0435\u0440\u0441\u0456\u044f %s"],"Premium":["Premium"],"Related Posts settings":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f Related Posts"],"Unsaved changes":["\u041d\u0435\u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0456 \u0437\u043c\u0456\u043d\u0438"],"You have unsaved changes.":["\u0423 \u0432\u0430\u0441 \u0454 \u043d\u0435\u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0456 \u0437\u043c\u0456\u043d\u0438."],"Discard":["\u0412\u0456\u0434\u043a\u0438\u043d\u0443\u0442\u0438"],"Settings saved.":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043e."],"The settings could not be saved.":["\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f."],"Save changes":["\u0417\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0437\u043c\u0456\u043d\u0438"],"This page does not exist.":["\u0422\u0430\u043a\u043e\u0457 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0438 \u043d\u0435 \u0456\u0441\u043d\u0443\u0454."],"Restore default":["\u0412\u0456\u0434\u043d\u043e\u0432\u0438\u0442\u0438 \u0442\u0438\u043f\u043e\u0432\u0435"],"This option is overwritten by a filter.":["\u0426\u0435\u0439 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440 \u043f\u0435\u0440\u0435\u0432\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043e \u0444\u0456\u043b\u044c\u0442\u0440\u043e\u043c."],"An installation is running. You can start another one when it is done.":["\u0417\u0430\u0440\u0430\u0437 \u0432\u0438\u043a\u043e\u043d\u0443\u0454\u0442\u044c\u0441\u044f \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f. \u0412\u0438 \u0437\u043c\u043e\u0436\u0435\u0442\u0435 \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0438 \u043d\u043e\u0432\u0435, \u043a\u043e\u043b\u0438 \u0432\u043e\u043d\u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044c\u0441\u044f."],"Link new posts":["\u041f\u043e\u0432'\u044f\u0437\u0430\u0442\u0438 \u043d\u043e\u0432\u0456 \u0437\u0430\u043f\u0438\u0441\u0438"],"Read and link the posts that are not linked yet, for example posts from before automatic linking was on. Links that exist stay as they are.":["\u041f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u0438 \u0439 \u043f\u043e\u0432'\u044f\u0437\u0430\u0442\u0438 \u0437\u0430\u043f\u0438\u0441\u0438, \u044f\u043a\u0456 \u0449\u0435 \u043d\u0435 \u043f\u043e\u0432'\u044f\u0437\u0430\u043d\u043e, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434 \u0437\u0430\u043f\u0438\u0441\u0438, \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u0456 \u0434\u043e \u0432\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043d\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e\u0433\u043e \u043f\u043e\u0432'\u044f\u0437\u0443\u0432\u0430\u043d\u043d\u044f. \u041d\u0430\u044f\u0432\u043d\u0456 \u0437\u0432'\u044f\u0437\u043a\u0438 \u0437\u0430\u043b\u0438\u0448\u0430\u0442\u044c\u0441\u044f \u0431\u0435\u0437 \u0437\u043c\u0456\u043d."],"Rebuild everything":["\u041f\u0435\u0440\u0435\u0431\u0443\u0434\u0443\u0432\u0430\u0442\u0438 \u0432\u0441\u0435"],"Start over: remove every related post link, also the links you added by hand, read all posts again and link them. Your posts themselves are never touched.":["\u041f\u043e\u0447\u0430\u0442\u0438 \u0437 \u043d\u0443\u043b\u044f: \u0432\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u0432\u0441\u0456 \u0437\u0432'\u044f\u0437\u043a\u0438 \u0441\u0445\u043e\u0436\u0438\u0445 \u0437\u0430\u043f\u0438\u0441\u0456\u0432, \u0437\u043e\u043a\u0440\u0435\u043c\u0430 \u0434\u043e\u0434\u0430\u043d\u0456 \u0432\u0440\u0443\u0447\u043d\u0443, \u0437\u043d\u043e\u0432\u0443 \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u0438 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0439 \u043f\u043e\u0432'\u044f\u0437\u0430\u0442\u0438 \u0457\u0445. \u0421\u0430\u043c\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u043d\u0456\u043a\u043e\u043b\u0438 \u043d\u0435 \u0437\u043c\u0456\u043d\u044e\u044e\u0442\u044c\u0441\u044f."],"Rebuild everything?":["\u041f\u0435\u0440\u0435\u0431\u0443\u0434\u0443\u0432\u0430\u0442\u0438 \u0432\u0441\u0435?"],"Remove links and rebuild":["\u0412\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u0437\u0432'\u044f\u0437\u043a\u0438 \u0439 \u043f\u0435\u0440\u0435\u0431\u0443\u0434\u0443\u0432\u0430\u0442\u0438"],"Keep my links":["\u0417\u0430\u043b\u0438\u0448\u0438\u0442\u0438 \u043c\u043e\u0457 \u0437\u0432'\u044f\u0437\u043a\u0438"],"Every related post link is removed, including the links you added by hand. This can not be undone.":["\u0423\u0441\u0456 \u0437\u0432'\u044f\u0437\u043a\u0438 \u0441\u0445\u043e\u0436\u0438\u0445 \u0437\u0430\u043f\u0438\u0441\u0456\u0432 \u0431\u0443\u0434\u0435 \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u043e, \u0437\u043e\u043a\u0440\u0435\u043c\u0430 \u0434\u043e\u0434\u0430\u043d\u0456 \u0432\u0440\u0443\u0447\u043d\u0443. \u0426\u044e \u0434\u0456\u044e \u043d\u0435\u043c\u043e\u0436\u043b\u0438\u0432\u043e \u0441\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438."]}}}