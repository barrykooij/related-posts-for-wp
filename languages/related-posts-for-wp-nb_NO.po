#: assets/build/admin/index.js:13
msgid "Version %s"
msgstr "Versjon %s"

#: assets/build/admin/index.js:16
msgid "Premium"
msgstr "Premium"

#: assets/build/admin/index.js:16
msgid "Related Posts settings"
msgstr "Innstillinger for Related Posts"

#: assets/build/admin/index.js:16
msgid "Unsaved changes"
msgstr "Ulagrede endringer"

#: assets/build/admin/index.js:16
msgid "You have unsaved changes."
msgstr "Du har ulagrede endringer."

#: assets/build/admin/index.js:16
msgid "Discard"
msgstr "Forkast"

#: assets/build/admin/index.js:16
msgid "Settings saved."
msgstr "Innstillingene er lagret."

#: assets/build/admin/index.js:16
msgid "The settings could not be saved."
msgstr "Innstillingene kunne ikke lagres."

#: assets/build/admin/index.js:16
msgid "Save changes"
msgstr "Lagre endringer"

#: assets/build/admin/index.js:16
msgid "This page does not exist."
msgstr "Denne siden finnes ikke."

#: assets/build/admin/index.js:16
msgid "This option is overwritten by a filter."
msgstr "Dette alternativet overstyres av et filter."

#: assets/build/admin/index.js:16
msgid "Installer"
msgstr "Installasjon"

#: assets/build/admin/index.js:16
msgid "An installation is running. You can start another one when it is done."
msgstr "En installasjon kjører. Du kan starte en ny når den er ferdig."

#: assets/build/admin/index.js:16
msgid "Link new posts"
msgstr "Koble nye innlegg"

#: assets/build/admin/index.js:16
msgid "Read and link the posts that are not linked yet, for example posts from before automatic linking was on. Links that exist stay as they are."
msgstr "Les og koble innleggene som ikke er koblet ennå, for eksempel innlegg fra før automatisk kobling var slått på. Eksisterende koblinger forblir som de er."

#: assets/build/admin/index.js:16
msgid "Rebuild everything"
msgstr "Bygg opp alt på nytt"

#: assets/build/admin/index.js:16
msgid "Start over: remove every related post link, also the links you added by hand, read all posts again and link them. Your posts themselves are never touched."
msgstr "Begynn på nytt: fjern alle koblinger til relaterte innlegg, også koblingene du har lagt til manuelt, les alle innleggene på nytt og koble dem. Selve innleggene dine blir aldri endret."

#: assets/build/admin/index.js:16
msgid "Rebuild everything?"
msgstr "Bygge opp alt på nytt?"

#: assets/build/admin/index.js:16
msgid "Remove links and rebuild"
msgstr "Fjern koblinger og bygg på nytt"

#: assets/build/admin/index.js:16
msgid "Keep my links"
msgstr "Behold koblingene mine"

#: assets/build/admin/index.js:16
msgid "Every related post link is removed, including the links you added by hand. This can not be undone."
msgstr "Alle koblinger til relaterte innlegg fjernes, også koblingene du har lagt til manuelt. Dette kan ikke angres."
