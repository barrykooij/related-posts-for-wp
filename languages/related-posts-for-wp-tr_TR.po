#: src/Settings/Settings.php:206
msgid "General"
msgstr "Genel"

#: src/Settings/Settings.php:207
msgid "The following options affect the general behaviour of the plugin."
msgstr "Aşağıdaki seçenekler eklentinin genel davranışını etkiler."

#: src/Settings/Settings.php:211
msgid "Enable"
msgstr "Etkinleştir"

#: src/Settings/Settings.php:212
msgid "Checking this will enable automatically linking posts to new posts"
msgstr "Bu seçenek işaretlendiğinde yeni yazılar ilgili yazılara otomatik olarak bağlanır"

#: src/Settings/Settings.php:218
msgid "Amount of Posts"
msgstr "Yazı sayısı"

#: src/Settings/Settings.php:219
msgid "The amount of automatically linked post"
msgstr "Otomatik olarak bağlanan yazı sayısı"

#: src/Settings/Settings.php:228
msgid "Heading text"
msgstr "Başlık metni"

#: src/Settings/Settings.php:229
msgid "The text that is displayed above the related posts. To disable, leave field empty."
msgstr "İlgili yazıların üstünde gösterilen metin. Devre dışı bırakmak için alanı boş bırakın."

#: src/Settings/Settings.php:235
msgid "Excerpt length"
msgstr "Özet uzunluğu"

#: src/Settings/Settings.php:236
msgid "The amount of words to be displayed below the title on website. To disable, set value to 0."
msgstr "Sitede başlığın altında gösterilecek kelime sayısı. Devre dışı bırakmak için değeri 0 yapın."

#: src/Settings/Settings.php:246
msgid "Styling"
msgstr "Stil"

#: src/Settings/Settings.php:247
msgid "The following options affect how related posts are displayed on the frontend."
msgstr "Aşağıdaki seçenekler ilgili yazıların sitenin ön yüzünde nasıl gösterileceğini etkiler."

#: src/Settings/Settings.php:251
msgid "Display Image"
msgstr "Görseli göster"

#: src/Settings/Settings.php:252
msgid "Checking this will enable displaying featured images of related posts."
msgstr "Bu seçenek işaretlendiğinde ilgili yazıların öne çıkarılmış görselleri gösterilir."

#: src/Settings/Settings.php:258
msgid "CSS"
msgstr "CSS"

#: src/Settings/Settings.php:259
msgid "Warning! This is an advanced feature! An error here will break frontend display. To disable, leave field empty."
msgstr "Uyarı! Bu gelişmiş bir özelliktir! Buradaki bir hata ön yüz görünümünü bozar. Devre dışı bırakmak için alanı boş bırakın."

#. translators: 1: the custom property for the space between posts, 2: the custom property for the image width
#: src/Settings/Settings.php:261
msgid "To change only the space between posts or the image width, set %1$s or %2$s in your theme instead."
msgstr "Yalnızca yazılar arasındaki boşluğu veya görsel genişliğini değiştirmek için bunun yerine temanızda %1$s veya %2$s ayarlayın."

#: src/Settings/Settings.php:273
msgid "Misc"
msgstr "Çeşitli"

#: src/Settings/Settings.php:274
msgid "A shelter for options that just don't fit in anywhere else."
msgstr "Başka hiçbir yere uymayan seçenekler için bir sığınak."

#: src/Settings/Settings.php:278
msgid "Remove Data on Uninstall?"
msgstr "Kaldırırken veriler silinsin mi?"

#: src/Settings/Settings.php:279
msgid "Check this box if you would like to completely remove all of its data when the plugin is deleted."
msgstr "Eklenti silindiğinde tüm verilerinin tamamen kaldırılmasını istiyorsanız bu kutuyu işaretleyin."

#: src/Settings/Settings.php:285
msgid "Show love?"
msgstr "Sevginizi gösterir misiniz?"

#: src/Settings/Settings.php:286
msgid "Display a 'Powered by' line under your related posts. <strong>BEWARE! Only for the real fans.</strong>"
msgstr "İlgili yazılarınızın altında bir 'Powered by' satırı gösterir. <strong>DİKKAT! Yalnızca gerçek hayranlar için.</strong>"

#: assets/build/admin/index.js:1
msgid "The settings could not be loaded."
msgstr "Ayarlar yüklenemedi."

#: assets/build/admin/index.js:1
msgid "The installer could not be reached."
msgstr "Kurulum aracına ulaşılamadı."

#: assets/build/admin/index.js:1 assets/build/admin/index.js:25
msgid "Installer"
msgstr "Kurulum"

#: assets/build/admin/index.js:1
msgid "All set! Your posts are linked."
msgstr "Her şey hazır! Yazılarınız bağlandı."

#: assets/build/admin/index.js:1
msgid "All set! Your posts are read."
msgstr "Her şey hazır! Yazılarınız okundu."

#: assets/build/admin/index.js:1
msgid "Every post shows its related posts now, and new posts are linked when you publish them."
msgstr "Artık her yazı kendi ilgili yazılarını gösteriyor; yeni yazılar da yayımladığınızda bağlanır."

#. translators: %s: the name of a tab of the settings screen, for example Installer
#: assets/build/admin/index.js:4
msgid "Link them from the %s tab when you are ready."
msgstr "Hazır olduğunuzda onları %s sekmesinden bağlayın."

#: assets/build/admin/index.js:4
msgid "Close"
msgstr "Kapat"

#: assets/build/admin/index.js:4
msgid "Less than a minute left"
msgstr "Bir dakikadan az kaldı"

#. translators: %s: a number of minutes
#: assets/build/admin/index.js:7
msgid "About %s minute left"
msgid_plural "About %s minutes left"
msgstr[0] "Yaklaşık %s dakika kaldı"
msgstr[1] "Yaklaşık %s dakika kaldı"

#. translators: 1: what the installation does now, 2: the number of that step, 3: the number of steps
#: assets/build/admin/index.js:10
msgid "%1$s (%2$s/%3$s)"
msgstr "%1$s (%2$s/%3$s)"

#. translators: 1: posts done, 2: all posts
#: assets/build/admin/index.js:13
