msgstr "Her şey hazır! Yazılarınız okundu."

#: assets/build/admin/index.js:1
msgid "Every post shows its related posts now, and new posts are linked when you publish them."
msgstr "Artık her yazı kendi ilgili yazılarını gösteriyor; yeni yazılar da yayımladığınızda bağlanır."

#: assets/build/admin/index.js:1
msgid "Link them from the Installer tab when you are ready."
msgstr "Hazır olduğunuzda onları Kurulum sekmesinden bağlayın."

#: assets/build/admin/index.js:1
msgid "Close"
msgstr "Kapat"

#: assets/build/admin/index.js:1
msgid "Less than a minute left"
msgstr "Bir dakikadan az kaldı"

