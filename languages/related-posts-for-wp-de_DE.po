msgstr "Die Installation konnte nicht gestartet werden."

#: assets/build/admin/index.js:19
msgid "Start"
msgstr "Starten"

#: assets/build/admin/index.js:19
msgid "The installation is done."
msgstr "Die Installation ist abgeschlossen."

#: assets/build/admin/index.js:19
msgid "The installation stopped."
msgstr "Die Installation wurde angehalten."

