msgstr "Version %s"

#: assets/build/admin/index.js:25
msgid "Premium"
msgstr "Premium"

#: assets/build/admin/index.js:25
msgid "Related Posts settings"
msgstr "Einstellungen von Related Posts"

#: assets/build/admin/index.js:25
msgid "Unsaved changes"
msgstr "Nicht gespeicherte Änderungen"

#: assets/build/admin/index.js:25
msgid "You have unsaved changes."
msgstr "Du hast nicht gespeicherte Änderungen."

#: assets/build/admin/index.js:25
msgid "Discard"
msgstr "Verwerfen"

#: assets/build/admin/index.js:25
msgid "Settings saved."
msgstr "Einstellungen gespeichert."

#: assets/build/admin/index.js:25
msgid "The settings could not be saved."
msgstr "Die Einstellungen konnten nicht gespeichert werden."

#: assets/build/admin/index.js:25
msgid "Save changes"
msgstr "Änderungen speichern"

#: assets/build/admin/index.js:25
msgid "This page does not exist."
msgstr "Diese Seite existiert nicht."

#: assets/build/admin/index.js:25
msgid "This option is overwritten by a filter."
msgstr "Diese Option wird durch einen Filter überschrieben."

#: assets/build/admin/index.js:25
msgid "An installation is running. You can start another one when it is done."
msgstr "Es läuft eine Installation. Du kannst eine neue starten, sobald sie abgeschlossen ist."

#: assets/build/admin/index.js:25
msgid "Link new posts"
msgstr "Neue Beiträge verknüpfen"

#: assets/build/admin/index.js:25
msgid "Read and link the posts that are not linked yet, for example posts from before automatic linking was on. Links that exist stay as they are."
msgstr "Liest die Beiträge ein, die noch nicht verknüpft sind, und verknüpft sie, zum Beispiel Beiträge aus der Zeit, bevor das automatische Verknüpfen aktiviert war. Bestehende Verknüpfungen bleiben unverändert."

#: assets/build/admin/index.js:25
msgid "Rebuild everything"
msgstr "Alles neu aufbauen"

#: assets/build/admin/index.js:25
msgid "Start over: remove every related post link, also the links you added by hand, read all posts again and link them. Your posts themselves are never touched."
msgstr "Von vorn beginnen: Entfernt alle Verknüpfungen zu verwandten Beiträgen, auch die von Hand hinzugefügten, liest alle Beiträge erneut ein und verknüpft sie. Deine Beiträge selbst bleiben immer unverändert."

#: assets/build/admin/index.js:25
msgid "Rebuild everything?"
msgstr "Alles neu aufbauen?"

#: assets/build/admin/index.js:25
msgid "Remove links and rebuild"
msgstr "Verknüpfungen entfernen und neu aufbauen"

#: assets/build/admin/index.js:25
msgid "Keep my links"
msgstr "Meine Verknüpfungen behalten"

#: assets/build/admin/index.js:25
msgid "Every related post link is removed, including the links you added by hand. This can not be undone."
msgstr "Alle Verknüpfungen zu verwandten Beiträgen werden entfernt, auch die von Hand hinzugefügten. Das kann nicht rückgängig gemacht werden."
